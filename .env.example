# Lo crea Vercel al conectar la base Neon (Storage). Para desarrollo: vercel env pull .env.local
DATABASE_URL="postgres://usuario:clave@host/neondb?sslmode=require"

# Contraseña con la que la dueña entra a la app
APP_PASSWORD="cambie-esta-clave"

# Zona horaria del restaurante (para saber qué semana es "hoy")
RESTAURANT_TZ="America/Costa_Rica"
